    },
    {
      "text": "Inside that file lay a template mismatch that triggered an out of bounds memory read.",
      "speaker": "narrator",
      "bg": "server_room",
      "counter": {
        "label": "INPUT MISMATCH",
        "value": "21 vs 20"
