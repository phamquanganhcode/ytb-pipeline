      "diagram": {
        "type": "code_crash",
        "title": "OUT-OF-BOUNDS MEMORY READ",
        "subtitle": "CSAgent.sys reads 21st slot of 20-input array",
        "highlightNode": 2
      }
    },
    {
      "text": "Channel File 291 requested twenty-one inputs, but the sensor only supplied twenty.",
      "speaker": "narrator",
      "bg": "server_room",
      "counter": {
        "label": "ARRAY SIZE",
        "value": "20 / 21"
      },
      "icons": [
        {
          "icon": "gear",
          "word": "inputs",
          "label": "MISMATCH"
        }
      ]
    },
    {
      "text": "With no runtime bounds check, the driver read past the array into invalid memory.",
      "speaker": "narrator",
      "bg": "server_room",
      "counter": {
        "label": "EXCEPTION",
        "value": "PAGE_FAULT"
      },
      "sfx": [
