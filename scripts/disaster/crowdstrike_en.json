    },
    {
      "text": "CrowdStrike pushed a tiny config file known as Channel Two Ninety-One.",
      "speaker": "narrator",
      "bg": "server_room",
      "counter": {
        "label": "PAYLOAD",
        "value": "Channel 291"
      },
      "diagram": {
        "type": "data_flow",
        "title": "CHANNEL FILE INJECTION",
        "subtitle": "Binary Ruleset Delivered to Kernel Driver",
        "highlightNode": 2
